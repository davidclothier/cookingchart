receta "Tacos de pollo con guacamole"
descripcion "Mucha preparación en frío en paralelo y tortillas que se calientan en el último momento"
cocina "Mexicana"
raciones 4
cocineros 1
plan justo_a_tiempo           # las tortillas, recién calentadas

ingredientes
  pollo      600 g     "Muslos de pollo"
  lima       3 ud
  ajo        2 dientes
  comino     1 cdta
  chile      1 cdta    "Chile en polvo"
  sal        al gusto
  aceite     2 cda
  aguacate   3 ud
  cebolla    1 ud
  tomate     2 ud
  jalapeno   1 ud      "Jalapeño"
  cilantro   1 rama
  tortillas  12 ud     "Tortillas de maíz"

herramientas
  sartén, comal, molcajete

bloque "Pollo"
  marinada       = mezclar(lima[1/3], ajo, comino, chile, sal) 3min
  pollo_marinado = marinar(pollo, marinada) 30min
  pollo_dorado   = dorar(pollo_marinado, aceite) en sartén @fuego:alto 12min
  pollo_picado   = picar(pollo_dorado) 3min aguanta 10min
fin

cebolla_picada = picar(cebolla) 3min
pico_de_gallo  "Pico de gallo" = mezclar(cebolla_picada[1/2], tomate, jalapeno, cilantro[1/2], lima[1/3]) 6min
guacamole      = majar(aguacate, cebolla_picada[1/2], cilantro[1/2], lima[1/3]) en molcajete 5min aguanta 30min

tortillas_calientes = calentar(tortillas) en comal 5min sin espera
tacos = montar(tortillas_calientes, pollo_picado, guacamole, pico_de_gallo) 5min

servir tacos "Tacos de pollo"
