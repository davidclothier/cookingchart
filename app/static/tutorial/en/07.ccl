recipe "Spaghetti with tomato sauce"
cooks 1
schedule just_in_time

ingredients
  pasta   200 g
  water   2 l
  salt    1 tbsp
  garlic  2 cloves
  oil     3 tbsp
  tomato  400 g
  basil   6 leaves

tools
  pot, pan, colander

boiling_water = boil(water) in pot 8min
cooked_pasta  = boil(pasta, boiling_water, salt) in pot 10min no wait
spaghetti     = drain(cooked_pasta) with colander 1min no wait

chopped_garlic = chop(garlic) 3min
soffritto      = sweat(chopped_garlic, oil) in pan @heat:low 5min
sauce          = simmer(soffritto, tomato) in pan @heat:medium 15min
  + basil at 12min

dish = mix(spaghetti, sauce) in pan 2min

serve dish
