receta "Espaguetis con tomate"

ingredientes
  pasta   200 g
  agua    2 l
  sal     1 cda
  ajo     2 dientes
  aceite  3 cda
  tomate  400 g

agua_hirviendo = hervir(agua) 8min
pasta_cocida   = cocer(pasta, agua_hirviendo, sal) 10min
espaguetis     = escurrir(pasta_cocida) 1min

ajo_picado = picar(ajo) 3min
sofrito    = pochar(ajo_picado, aceite) 5min
salsa      = guisar(sofrito, tomate) 15min

plato = mezclar(espaguetis, salsa) 2min

servir plato
